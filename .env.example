# Environment Variables:backend/.env
# --- Flask Server Port ---
FLASK_HOST='127.0.0.1'
FLASK_RUN_PORT='8082'

# --- Application Security ---
SECRET_KEY='your_secret_key_here'

# --- PostgreSQL Connection ---
# Neon pooled connection, used when FLASK_ENV=production.
DATABASE_URL=postgresql://<your_db_username>:<your_db_password>@localhost:5432/healthvault
DIRECT_URL=postgresql://<your_db_username>:<your_db_password>@localhost:5432/healthvault


CLOUDFLARE_TUNNEL_TOKEN=

# --- Gemini API Key ---
GEMINI_API_KEY=

# --- GROQ API Key ---
GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-120b

# --- Redis Cache (M1) ---
# --- Redis Cache ---
REDIS_URL=redis://127.0.0.1:6379

# --- Flask-Mail Credentials (Use App-Specific Password for Gmail) ---
# IMPORTANT: Use the actual SMTP server hostname, not a URL
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Health Vault
MAIL_SERVER=smtpout.secureserver.net
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_DEBUG=True
# which is why it's set to True here for secure TLS communication.