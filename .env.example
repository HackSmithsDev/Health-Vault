# Environment Variables:backend/.env
# --- Flask Server Port ---
FLASK_HOST=your_flask_host_here
FLASK_RUN_PORT=your_flask_run_port_here

# --- Application Security ---
SECRET_KEY='your_secret_key_here'

# --- PostgreSQL Connection ---
# Set this if your local PostgreSQL setup is different from the default in config.py
DATABASE_URL='postgresql://<username>:<password>@<pooler-host>/<db_name>?sslmode=require'
DIRECT_URL='postgresql://<username>:<password>@<direct-host>/<db_name>?sslmode=require'

# --- Gemini API Key ---
GEMINI_API_KEY='your_gemini_api_key_here'

# --- GROQ API Key ---
GROQ_API_KEY='your_groq_api_key_here'

GROQ_MODEL='your_groq_model_here'

# --- Redis Cache (M1) ---
# --- Redis Cache ---
REDIS_URL='rediss://default:<password>@<upstash-host>:6379'

# --- Flask-Mail Credentials (GoDaddy Professional Mail) ---
MAIL_SERVER='smtpout.secureserver.net'
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_DEBUG=False
MAIL_USERNAME='your_email_username_here'
MAIL_PASSWORD='your-titan-mailbox-password'
MAIL_FROM='your_email_from_address'
MAIL_FROM_NAME='your_email_from_name'
# which is why it's set to True here for secure TLS communication.