# Environment Variables:backend/.env
# --- Flask Server Port ---
FLASK_HOST=your_flask_host_here
FLASK_RUN_PORT=your_flask_run_port_here

# --- Application Security ---
SECRET_KEY='your_secret_key_here'

# --- PostgreSQL Connection ---
# Set this if your local PostgreSQL setup is different from the default in config.py
DATABASE_URI='postgresql://<username>:<password>@<host>:5432/<db_name>'

# --- Gemini API Key ---
GEMINI_API_KEY='your_gemini_api_key_here'

# --- GROQ API Key ---
GROQ_API_KEY='your_groq_api_key_here'

# --- Redis Cache (M1) ---
REDIS_URI='redis://localhost:6379/0'

# --- Flask-Mail Credentials (Use App-Specific Password for Gmail) ---
# IMPORTANT: Use the actual SMTP server hostname, not a URL
MAIL_SERVER='smtp.gmail.com'
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME='your.cognilit.email@gmail.com'
MAIL_PASSWORD='your_app_specific_password'
MAIL_DEFAULT_SENDER='your.default.email.sender'
# If you leave MAIL_USE_TLS unset in the .env file, it defaults to False,
# which is why it's set to True here for secure TLS communication.